# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://localhost:27017/video_streaming

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9010
MINIO_HOST_PORT=9010
MINIO_CONSOLE_PORT=9011

# Frontend
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uploads
VIDEO_MAX_SIZE=5368709120
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime,video/x-matroska
ALLOWED_VIDEO_EXTENSIONS=.mp4,.webm,.mov,.mkv

# FFmpeg / HLS
HLS_SEGMENT_DURATION=6
FFMPEG_PRESET=medium
FFMPEG_CRF=23
WORKER_CONCURRENCY=1
WORKER_TEMP_DIR=/tmp/video-processing

# Auth (API signs cookies; web middleware verifies the same JWT)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=video_session

# HTTP
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
UPLOAD_RATE_LIMIT_MAX=50

# Nginx (documentation / compose)
NGINX_CLIENT_MAX_BODY_SIZE=5G
